# Copy to .env (or set these in the Vercel project settings) before building.
# Nothing here has a default: an unset value is simply not used.

# The absolute production origin, no trailing slash. Vite substitutes this
# into index.html for the canonical link and the Open Graph / Twitter URLs.
# Without it those tags ship with the literal %VITE_SITE_URL% in them.
VITE_SITE_URL=https://ssaff666.in

# --- Analytics (optional) ---------------------------------------------------
# Left unset, the build ships no analytics and no tracking of any kind.
# Set the full script URL your provider gives you. No ID is assumed here:
# whatever data-* attributes your provider needs go in VITE_ANALYTICS_DATA as
# comma-separated key=value pairs.
#
#   VITE_ANALYTICS_SRC=https://analytics.example.com/script.js
#   VITE_ANALYTICS_DATA=website-id=YOUR-ID-HERE
#
# Note: enabling analytics means the site starts processing visitor data, at
# which point a privacy policy is required in most jurisdictions, and a
# consent banner too if the provider sets cookies or fingerprints.
